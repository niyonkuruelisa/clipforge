{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clipforge",
  "version": "0.0.1",
  "identifier": "com.niyonkuruelisa.clipforge",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/clipforge/browser"
  },
  "app": {
    "windows": [
      {
        "title": "clipforge",
        "width": 360,
        "height": 640,
        "resizable": false,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
